                ],
                "summary": "Crear nuevo cliente",
                "operationId": "dc5e432e5e3fac5c9a33211321b7c677",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "nombre_comercial": {
                                        "type": "string"
                                    },
                                    "rut_id_comercial": {
                                        "type": "string"
                                    },
                                    "direccion": {
                                        "type": "string"
                                    },
                                    "categoria": {
                                        "description": "Regular o Preferencial",
                                        "type": "string"
                                    },
                                    "contacto_nombre": {
                                        "type": "string"
                                    },
                                    "contacto_correo": {
                                        "type": "string"
                                    },
                                    "porcentaje_oferta": {
                                        "type": "number",
                                        "format": "float"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Cliente creado"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                }
            }
        },
        "/clientes/{id}": {
            "get": {
                "tags": [
                    "Clientes"
                ],
                "summary": "Mostrar un cliente",
