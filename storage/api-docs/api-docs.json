                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Cliente actualizado"
                    },
                    "404": {
                        "description": "No encontrado"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Clientes"
                ],
                "summary": "Eliminar cliente",
                "operationId": "1e07c53a890418d3fc1f435d51aaf8cb",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cliente eliminado"
                    },
                    "400": {
                        "description": "No se puede eliminar porque tiene camisetas asociadas"
                    },
                    "404": {
                        "description": "No encontrado"
                    }
                }
            }
        },
        "/clientes/{id}/camisetas": {
            "get": {
                "tags": [
                    "Clientes"
                ],
