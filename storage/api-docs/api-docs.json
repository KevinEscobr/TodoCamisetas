{
    "openapi": "3.0.0",
    "info": {
        "title": "TodoCamisetas API",
        "description": "API RESTful para la gestión del catálogo de camisetas, clientes B2B y tallas.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "Servidor Principal"
        }
    ],
    "paths": {
        "/camisetas": {
            "get": {
                "tags": [
                    "Camisetas"
                ],
                "summary": "Listar todas las camisetas",
                "operationId": "35d4335af949ff3fbd508207ceaf47b6",
                "parameters": [
                    {
                        "name": "cliente_id",
                        "in": "query",
                        "description": "ID del cliente para calcular el precio dinámico",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de camisetas obtenida correctamente"
                    }
                }
            },
            "post": {
                "tags": [
                    "Camisetas"
                ],
                "summary": "Crear nueva camiseta",
                "operationId": "2ed861e54d8dcbc6539ecb57424c0c58",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "titulo": {
                                        "type": "string"
                                    },
                                    "club": {
                                        "type": "string"
                                    },
                                    "pais": {
                                        "type": "string"
                                    },
                                    "tipo": {
                                        "type": "string"
                                    },
                                    "color": {
                                        "type": "string"
                                    },
                                    "precio": {
                                        "type": "integer"
                                    },
                                    "precio_oferta": {
                                        "type": "integer",
                                        "nullable": true
                                    },
                                    "cantidad": {
                                        "type": "integer"
                                    },
                                    "tallas": {
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        }
                                    },
                                    "sku": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Camiseta creada"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                }
            }
        },
        "/camisetas/{id}": {
            "get": {
                "tags": [
                    "Camisetas"
                ],
                "summary": "Mostrar una camiseta",
                "operationId": "14eb3175736bb9a65934cb9f190d300b",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "cliente_id",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Camiseta encontrada"
                    },
                    "404": {
                        "description": "Camiseta no encontrada"
                    }
                }
            },
            "put": {
                "tags": [
                    "Camisetas"
                ],
                "summary": "Actualizar camiseta",
                "operationId": "136974e45cf6cbf642b35fea7fafcd4f",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "precio": {
                                        "type": "integer"
                                    },
                                    "cantidad": {
                                        "type": "integer"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Camiseta actualizada"
                    },
                    "404": {
                        "description": "No encontrada"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Camisetas"
                ],
                "summary": "Eliminar camiseta",
                "operationId": "0f889680e95aa2c4e72fb01ba75562ba",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Camiseta eliminada"
                    },
                    "404": {
                        "description": "No encontrada"
                    }
                }
            }
        },
